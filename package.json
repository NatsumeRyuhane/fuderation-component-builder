{
  "name": "fuderation-component-builder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Workspace for building Fuderation Workshop components (src -> importable build JSON).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs .agents/skills/fuderation-component-builder/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "vendor:runtime": "node scripts/vendor-runtime.mjs",
    "build:diagnostics": "node .agents/skills/fuderation-component-builder/scripts/build-diagnostics.mjs",
    "test:diagnostics": "node --test .agents/skills/fuderation-component-builder/tests/*.test.mjs"
  },
  "devDependencies": {
    "@csstools/css-tokenizer": "^3.0.4",
    "acorn": "^8.18.0",
    "base32768": "5.0.1",
    "dompurify": "^3.4.14",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "markdown-it": "^15.0.1",
    "parse5-sax-parser": "^7.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.7.0"
  }
}
